# Calliope : modèle commun des .env Salks.
# En local : ce fichier. Sur Cloudflare : mêmes clés dans Settings > Variables and Secrets
# (les NEXT_PUBLIC_* doivent aussi être définies pour le build).

# --- Commun à tous les sites Salks. ---
# Adresse publique du site
NEXT_PUBLIC_SITE_URL=https://calliope.salks.fr
# Olympe, l'API centrale : mesure d'audience, documents légaux, chiffres des bots
NEXT_PUBLIC_OLYMPE_URL=https://olympe.salks.fr

# --- Propre au site ---
# Seulement si le site est servi dans un sous-dossier
NEXT_PUBLIC_BASE_PATH=
