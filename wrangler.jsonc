// Cloudflare Workers : laisse les commandes par défaut du tableau de bord
// (Build command vide, Deploy command `npx wrangler deploy`) : le build est lancé par "build" ci-dessous.
{
  "name": "calliope",
  "compatibility_date": "2025-09-23",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "build": {
    "command": "npm run build"
  }
}
